# ==============================================================================
# FinEasy AI - Environment Configuration Example
# ==============================================================================
# NOTE: This is an educational prototype. Never commit real secrets or production keys.

# Supabase PostgreSQL & Auth Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-or-secret-key

# Google Gemini API Key (Using official google-genai SDK)
GEMINI_API_KEY=your-gemini-api-key

# Mock Government API URL
MOCK_GOVERNMENT_URL=http://127.0.0.1:8001

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:3000,http://127.0.0.1:3000
